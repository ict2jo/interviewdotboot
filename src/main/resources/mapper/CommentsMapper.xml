<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ict.interviewdotboot.mapper.CommentsMapper">
    <select id="getComments" resultType="CommentVO">
        SELECT * FROM Review_com  WHERE r_idx = #{r_idx}
    </select>
    <!-- <select id="getComments" resultType="CommentVO">
        SELECT * FROM Review_com  WHERE r_idx = #{r_idx} ORDER BY re_regdate DESC
    </select> -->
    <insert id="insertComment" parameterType="CommentVO">
        INSERT INTO Review_com (re_idx, r_idx, id, re_content, re_regdate)
        VALUES(#{re_idx}, #{r_idx}, #{id},  #{re_content}, sysdate())
    </insert>
</mapper>